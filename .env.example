# Local Python executable used to run edge-tts.
# Windows can use: py -3
PYTHON_BIN=

# Clear, natural voices for educational Q&A content.
QUESTION_VOICE=
ANSWER_VOICE=

# Negative values slow speech down. Start at -10% for natural pacing.
TTS_RATE=

# Frontend origin allowed by the backend CORS configuration.
# Local development can use http://127.0.0.1:5173
# Production should contain the deployed frontend origin.
FRONTEND_URL=

# Public URL of the deployed backend used by the Vite frontend.
# Local development can use http://127.0.0.1:3001
VITE_API_BASE_URL=
